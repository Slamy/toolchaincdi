[submodule "binutils-gdb"]
	path = src/binutils-gdb
	url = https://github.com/cdifan/binutils-gdb.git
	branch = m68k-gas-fixes
[submodule "gcc"]
	path = src/gcc
	url = https://github.com/cdifan/gcc.git
	branch = 11.1.0-os9-compat
[submodule "newlib-cygwin"]
	path = src/newlib-cygwin
	url = https://github.com/cdifan/newlib-cygwin.git
	branch = newlib-4.1.0-os9-compat
[submodule "psximager"]
	path = src/psximager
	url = https://github.com/murachue/psximager.git
	branch = cdi
[submodule "m68k-os9-tools"]
	path = src/m68k-os9-tools
	url = https://github.com/cdifan/m68k-os9-tools.git
	branch = main-compat
[submodule "test/abi-exec/musashi"]
	path = test/abi-exec/musashi
	url = https://github.com/kstenerud/Musashi.git
	branch = master
