* tests/returns.S in Microware's r68 syntax (make check-r68).

 psect returns_a,0,0,0,0,0

mw_retf: move.l #$3FC00000,d0 float mw_retf (void): 1.5f
 rts

mw_retd: move.l #$40040000,d0 double mw_retd (void): 2.5
 moveq #0,d1
 rts

* struct { int a, b, c; } mw_rets (int x): { x, x + 1, x + 2 }
mw_rets: move.l d0,(a0)
 addq.l #1,d0
 move.l d0,4(a0)
 addq.l #1,d0
 move.l d0,8(a0)
 move.l #$BAD0BAD0,d0 nothing is returned in d0
 rts

mw_rets1: move.b d0,(a0) struct { char c; } mw_rets1 (int x): { x }
 move.l #$BAD0BAD0,d0
 rts

* Callers, calling GCC functions the Ultra C 2.5 way for structs.

* g_rets (5) into a buffer; returns a+b+c, or -1 if a0 wasn't preserved
call_g_rets: movem.l a0/a2,-(sp) a0 too: callers keep values there
 lea -12(sp),sp
 move.l sp,a0
 move.l a0,a2
 moveq #5,d0
 bsr g_rets
 cmp.l a0,a2
 bne.s rets_bad
 move.l (sp),d0
 add.l 4(sp),d0
 add.l 8(sp),d0
 bra.s rets_end
rets_bad moveq #-1,d0
rets_end lea 12(sp),sp
 movem.l (sp)+,a0/a2
 rts

call_g_retf: bsr g_retf returns g_retf ()'s d0 as is
 rts

 ends
